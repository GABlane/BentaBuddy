# Optional Facebook Messenger webhook configuration; keep real values out of git.
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PAGE_ID=
# Optional: customer names/photos from Meta. Backend only; never prefix with VITE_.
META_PAGE_ACCESS_TOKEN=
META_GRAPH_VERSION=v22.0
# Defaults use the bundled local llama.cpp server.
BENTABUDDY_RUNTIME=llamacpp
BENTABUDDY_MODEL=qwen3:4b-instruct-2507-q4_K_M
# Loopback by default. Set explicitly to 0.0.0.0 only for a trusted LAN demo.
BENTABUDDY_HOST=127.0.0.1
